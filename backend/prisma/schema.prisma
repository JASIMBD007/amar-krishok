generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BUYER
  FARMER
  GUEST
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum LotStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  CANCELLED
}

enum OrderStatus {
  PENDING
  MATCHING
  PICKUP_BOOKED
  IN_TRANSIT
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

enum LogisticsStatus {
  SCHEDULED
  PICKUP_BOOKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
}

enum ChatStatus {
  OPEN
  WAITING
  RESOLVED
}

model User {
  id                String                @id @default(cuid())
  name              String
  phone             String
  passwordHash      String
  role              Role
  status            AccountStatus         @default(PENDING)
  organization      String?
  address           String?
  identity          String?
  focus             String?
  districtId        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  reviewedAt        DateTime?
  district          District?             @relation(fields: [districtId], references: [id])
  buyerProfile      BuyerProfile?
  farmerProfile     FarmerProfile?
  cropLots          CropLot[]             @relation("FarmerLots")
  orders            Order[]               @relation("BuyerOrders")
  payouts           Payout[]              @relation("FarmerPayouts")
  notifications     Notification[]
  auditLogs         AuditLog[]
  uploadedFiles     UploadedFile[]
  chatMessages      ChatMessage[]

  @@unique([phone, role])
  @@index([role, status])
}

model BuyerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyerType   String?
  monthlyNeed String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FarmerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmSize    String?
  walletPhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model District {
  id            String        @id @default(cuid())
  name          String        @unique
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         User[]
  cropLots      CropLot[]
  orders        Order[]
  marketPrices  MarketPrice[]
  logisticsFrom LogisticsJob[] @relation("OriginDistrict")
  logisticsTo   LogisticsJob[] @relation("DestinationDistrict")
}

model Crop {
  id           String        @id @default(cuid())
  name         String        @unique
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cropLots     CropLot[]
  orderItems   OrderItem[]
  marketPrices MarketPrice[]
}

model CropLot {
  id             String         @id @default(cuid())
  farmerId       String
  cropId         String
  districtId     String
  quantityKg     Decimal        @db.Decimal(12, 2)
  pricePerKg     Decimal        @db.Decimal(12, 2)
  grade          String
  harvestDate    DateTime?
  status         LotStatus      @default(ACTIVE)
  notes          String?
  imageUrl       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  farmer         User           @relation("FarmerLots", fields: [farmerId], references: [id])
  crop           Crop           @relation(fields: [cropId], references: [id])
  district       District       @relation(fields: [districtId], references: [id])
  orderItems     OrderItem[]
  logisticsJobs  LogisticsJob[]
  qualityChecks  QualityCheck[]

  @@index([cropId, districtId, status])
  @@index([farmerId, status])
}

model Order {
  id              String         @id @default(cuid())
  buyerId         String
  districtId      String
  status          OrderStatus    @default(PENDING)
  deliveryAddress String
  targetDate      DateTime?
  totalValue      Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  buyer           User           @relation("BuyerOrders", fields: [buyerId], references: [id])
  district        District       @relation(fields: [districtId], references: [id])
  items           OrderItem[]
  logisticsJobs   LogisticsJob[]
  payments        Payment[]

  @@index([buyerId, status])
  @@index([districtId, status])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  cropId            String
  cropLotId         String?
  quantityKg        Decimal  @db.Decimal(12, 2)
  offeredPricePerKg Decimal  @db.Decimal(12, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  crop              Crop     @relation(fields: [cropId], references: [id])
  cropLot           CropLot? @relation(fields: [cropLotId], references: [id])
}

model MarketPrice {
  id          String   @id @default(cuid())
  cropId      String
  districtId  String
  farmerAsk   Decimal  @db.Decimal(12, 2)
  wholesale   Decimal  @db.Decimal(12, 2)
  retail      Decimal  @db.Decimal(12, 2)
  source      String?
  priceDate   DateTime
  createdAt   DateTime @default(now())
  crop        Crop     @relation(fields: [cropId], references: [id])
  district    District @relation(fields: [districtId], references: [id])

  @@unique([cropId, districtId, priceDate])
  @@index([priceDate])
}

model LogisticsJob {
  id                    String          @id @default(cuid())
  orderId               String?
  cropLotId             String?
  originDistrictId      String?
  destinationDistrictId String?
  driverName            String
  vehicle               String?
  status                LogisticsStatus @default(SCHEDULED)
  pickupAt              DateTime?
  deliveredAt           DateTime?
  proofUrl              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  order                 Order?          @relation(fields: [orderId], references: [id])
  cropLot               CropLot?        @relation(fields: [cropLotId], references: [id])
  originDistrict        District?       @relation("OriginDistrict", fields: [originDistrictId], references: [id])
  destinationDistrict   District?       @relation("DestinationDistrict", fields: [destinationDistrictId], references: [id])
}

model QualityCheck {
  id        String   @id @default(cuid())
  cropLotId String
  grade     String
  notes     String?
  proofUrl  String?
  passed    Boolean  @default(false)
  createdAt DateTime @default(now())
  cropLot   CropLot  @relation(fields: [cropLotId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  escrowRef   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id])
  payouts     Payout[]
}

model Payout {
  id          String        @id @default(cuid())
  paymentId   String
  farmerId    String
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  walletRef   String?
  releasedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payment     Payment       @relation(fields: [paymentId], references: [id])
  farmer      User          @relation("FarmerPayouts", fields: [farmerId], references: [id])
}

model ChatThread {
  id               String        @id @default(cuid())
  participantId    String?
  participantRole  Role
  participantName  String
  participantPhone String
  subject          String
  status           ChatStatus    @default(WAITING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  messages         ChatMessage[]

  @@index([participantPhone, participantRole])
  @@index([status, updatedAt])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  senderId   String?
  senderRole Role
  senderName String
  text       String
  createdAt  DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender     User?      @relation(fields: [senderId], references: [id])

  @@index([threadId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UploadedFile {
  id        String   @id @default(cuid())
  ownerId   String?
  url       String
  key       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  owner     User?    @relation(fields: [ownerId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}
