# Include the versioned prefix from ARCHITECTURE.md section 4.
# This URL works from Expo Go on a physical phone.
EXPO_PUBLIC_API_BASE_URL=https://amar-krishok-api.onrender.com/api/v1

# To use a backend running on your Mac, replace the value above with the Mac's
# LAN address (not localhost), for example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:4000/api/v1
