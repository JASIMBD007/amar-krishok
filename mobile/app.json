{
  "expo": {
    "name": "AmarKrishok",
    "slug": "amar-krishok",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f4f2ea"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amarkrishok.mobile"
    },
    "android": {
      "package": "com.amarkrishok.mobile"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
