{
  "name": "amar-krishok",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "backend:build": "npm --prefix backend run build",
    "backend:dev": "npm --prefix backend run dev",
    "backend:prisma:generate": "npm --prefix backend run prisma:generate",
    "backend:prisma:migrate": "npm --prefix backend run prisma:migrate",
    "mobile:check": "npm --prefix mobile run check",
    "mobile:lint": "npm --prefix mobile run lint",
    "mobile:test": "npm --prefix mobile run test",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "test:mobile-role": "npm --prefix backend run test:mobile",
    "seed": "npm --prefix backend run seed",
    "test:p0": "npm --prefix backend run test:p0",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src backend/src backend/prisma/*.ts scripts/*.mjs vite.config.ts",
    "check": "npm run lint && npm run build && npm run backend:build",
    "build": "tsc -b && vite build && node scripts/prerender-public.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.10.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0"
  }
}
